<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>ResQ.BuildingBlocks.Adapters.Messaging</PackageId>
    <Description>Broker-agnostic messaging adapter — implements the application's integration-event ports over an in-memory System.Threading.Channels transport, with System.Text.Json serialization, a concurrency-bounded and idempotent BackgroundService consumer (Polly retry + dead-lettering), and DI wiring. Ships no broker client.</Description>
    <PackageTags>messaging;integration-events;channels;polly;idempotency;hexagonal;building-blocks</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ResQ.BuildingBlocks.Application\ResQ.BuildingBlocks.Application.csproj" />
    <ProjectReference Include="..\ResQ.BuildingBlocks.Domain\ResQ.BuildingBlocks.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Polly.Core" />
    <PackageReference Include="Scrutor" />
  </ItemGroup>

</Project>
