<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>ResQ.BuildingBlocks.Adapters.Persistence</PackageId>
    <Description>EF Core 9 persistence adapter — the scoped EfUnitOfWork that dispatches domain events before saving, a specification-driven Repository/ReadRepository, an audit interceptor, and a transactional outbox plus inbox idempotency. Provider-agnostic (references only EF Core + Relational); depends only on the application and domain cores.</Description>
    <PackageTags>ef-core;persistence;unit-of-work;outbox;inbox;repository;specification;adapter;hexagonal;building-blocks</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ResQ.BuildingBlocks.Application\ResQ.BuildingBlocks.Application.csproj" />
    <ProjectReference Include="..\ResQ.BuildingBlocks.Domain\ResQ.BuildingBlocks.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Scrutor" />
  </ItemGroup>

</Project>
