<?xml version="1.0" encoding="utf-8"?>
<!--
  Supply-chain pinning for the ResQ.BuildingBlocks solution.

  <clear/> drops any machine- or user-level feeds a contributor (or CI runner) may have inherited, so
  restore is reproducible from a single, explicit source: nuget.org. packageSourceMapping then binds
  EVERY package pattern to that one source, closing the door on dependency-confusion / source-hijack
  (a package can only ever come from the source its pattern maps to).

  Scope note: this file lives at the repo root and only governs restores rooted here. The `dotnet new`
  template content under templates/resq-service/ is shipped verbatim and scaffolded/restored OUTSIDE
  this tree (its own generated nuget.config wins), so it does not inherit this strict source list.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
