# Normalize line endings: treat everything as text and check out with LF.
* text=auto eol=lf

# Explicit text types.
*.cs        text diff=csharp
*.csproj    text
*.props     text
*.targets   text
*.slnx      text
*.json      text
*.yml       text
*.yaml      text
*.md        text
*.sh        text eol=lf

# gh-aw compiled agentic workflows are generated from the sibling *.md.
.github/workflows/*.lock.yml linguist-generated=true merge=ours

# Binaries — never normalize.
*.png       binary
*.jpg       binary
*.ico       binary
*.snk       binary
*.nupkg     binary

.github/workflows/*.lock.yml linguist-generated=true merge=ours