root = true

[*.cs]
# Curated analyzer baseline for a ResQ service (mirrors the building-blocks baseline).

# 'Error' is the idiomatic name in the Result/Error pattern; the VB-keyword clash is noise.
dotnet_diagnostic.CA1716.severity = none

# Nullable reference types already guard public-parameter null-ness (handlers also ThrowIfNull).
dotnet_diagnostic.CA1062.severity = none

# High-perf LoggerMessage source-gen is a worthwhile future polish, not required in thin services.
dotnet_diagnostic.CA1848.severity = none
